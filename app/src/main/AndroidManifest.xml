<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissões do Foreground Service e de Notificação (Guia Prático 4) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Necessária para verificar o tipo de rede (Wi-Fi / dados móveis) antes de sincronizar -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ===== Telas do app (cada uma demonstra um conceito) ===== -->
        <!-- Módulo 2 • Desafio 1 -->
        <activity
            android:name=".SensorActivity"
            android:exported="false"
            android:label="Acelerômetro"
            android:parentActivityName=".MainActivity" />

        <!-- Módulo 4 • Guia Prático 4 -->
        <activity
            android:name=".ServicoActivity"
            android:exported="false"
            android:label="Foreground Service"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="Log de atividades"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".NotificacaoActivity"
            android:exported="false"
            android:label="Notificações"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ThreadsActivity"
            android:exported="false"
            android:label="Main Thread vs Corrotinas"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".BateriaActivity"
            android:exported="false"
            android:label="Bateria e Doze"
            android:parentActivityName=".MainActivity" />

        <!-- Registro obrigatório do Service Personalizado -->
        <service
            android:name=".SincronizacaoService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>